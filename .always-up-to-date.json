{
  "$schema": "./node_modules/@pixel-perfect-software/always-up-to-date/schema/config.schema.json",
  "beyondRange": "minor",
  "cooldown": "7 days",
  "rules": {
    "vitest": "hold",
    "@vitest/*": "hold",
    "jest": "hold",
    "jest-*": "hold",
    "@jest/*": "hold",
    "babel-jest": "hold",
    "babel-plugin-jest-hoist": "hold",
    "expect": "hold",
    "pretty-format": "hold",
    "@sinonjs/fake-timers": "hold",
    "istanbul-lib-*": "hold",
    "@istanbuljs/*": "hold",
    "@types/istanbul-lib-*": "hold",
    "babel-plugin-istanbul": "hold",
    "istanbul-reports": "hold",
    "@types/istanbul-reports": "hold",
    "v8-to-istanbul": "hold",
    "@bcoe/v8-coverage": "hold"
  }
}
