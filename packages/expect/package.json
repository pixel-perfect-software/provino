{
  "name": "@provino/expect",
  "version": "0.0.0",
  "description": "Provino's expect engine: a lazy front end, per-test matcher state and the global matcher slot, with matchers and messages supplied by a dialect.",
  "homepage": "https://github.com/pixel-perfect-software/provino#readme",
  "bugs": {
    "url": "https://github.com/pixel-perfect-software/provino/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-perfect-software/provino.git",
    "directory": "packages/expect"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "provino-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "build": "tsdown --config ../../tooling/packaging/tsdown.config.ts",
    "test": "node --test --conditions=provino-source \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@jest/expect-utils": "catalog:",
    "@provino/snapshot": "workspace:*",
    "@provino/types": "workspace:*"
  },
  "devDependencies": {
    "@provino/policy": "workspace:*",
    "@vitest/expect": "catalog:",
    "expect": "catalog:"
  }
}
