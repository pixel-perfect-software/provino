{
  "name": "@provino/transform",
  "version": "0.0.0",
  "description": "Provino's transform pipeline: TypeScript and JSX through Oxc, the mock-hoisting hook point, source-map composition and import records.",
  "homepage": "https://github.com/pixel-perfect-software/provino#readme",
  "bugs": {
    "url": "https://github.com/pixel-perfect-software/provino/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-perfect-software/provino.git",
    "directory": "packages/transform"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
