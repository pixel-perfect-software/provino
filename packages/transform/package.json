{
  "name": "@provino/transform",
  "version": "0.1.0-rc.7",
  "description": "Provino's transform pipeline: TypeScript and JSX through Oxc, mock hoisting, source-map composition and import records.",
  "homepage": "https://github.com/pixel-perfect-software/provino#readme",
  "bugs": {
    "url": "https://github.com/pixel-perfect-software/provino/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-perfect-software/provino.git",
    "directory": "packages/transform"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "provino-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v8cache": {
      "provino-source": "./src/v8cache/index.ts",
      "types": "./dist/v8cache.d.ts",
      "import": "./dist/v8cache.js"
    },
    "./vite": {
      "provino-source": "./src/vite/index.ts",
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "build": "tsdown --config ../../tooling/packaging/tsdown.config.ts",
    "test": "node ../../node_modules/provino-runner/dist/cli.js run"
  },
  "dependencies": {
    "@jridgewell/remapping": "catalog:",
    "@provino/types": "workspace:*",
    "magic-string": "catalog:",
    "oxc-parser": "catalog:",
    "oxc-transform": "catalog:",
    "oxc-walker": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-modules-commonjs": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@jest/globals": "catalog:",
    "@jest/transform": "catalog:",
    "@jridgewell/trace-mapping": "catalog:",
    "@oxc-project/types": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "babel-jest": "catalog:",
    "jest": "catalog:",
    "svelte": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "npm:typescript@5.9.3",
    "vite-plugin-svgr": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
