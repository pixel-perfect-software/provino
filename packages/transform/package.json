    "@babel/preset-typescript": "catalog:",
    "@jest/globals": "catalog:",
    "@jest/transform": "catalog:",
    "@jridgewell/trace-mapping": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "babel-jest": "catalog:",
