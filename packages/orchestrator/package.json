{
  "name": "@provino/orchestrator",
  "version": "0.0.0",
  "description": "Provino's coordinator: worker transports (forks, threads, inline), the per-worker connection, and the worker-side event packer.",
  "homepage": "https://github.com/pixel-perfect-software/provino#readme",
  "bugs": {
    "url": "https://github.com/pixel-perfect-software/provino/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-perfect-software/provino.git",
    "directory": "packages/orchestrator"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "provino-source": "./src/index.ts",
      "types": "./dist/index.d.ts"
    },
    "./worker": {
      "provino-source": "./src/worker/index.ts",
      "types": "./dist/worker/index.d.ts"
    },
    "./worker/bootstrap": {
      "provino-source": "./src/worker/bootstrap.ts",
      "types": "./dist/worker/bootstrap.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "test": "node --test --conditions=provino-source \"src/**/*.test.ts\" \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@provino/rpc": "workspace:*",
    "@provino/types": "workspace:*"
  },
  "devDependencies": {
    "@provino/policy": "workspace:*"
  }
}
