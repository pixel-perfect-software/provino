{
  "name": "@provino/snapshot",
  "version": "0.1.0-rc.11",
  "description": "Provino's snapshot engine: the .snap file format and the per-file state machine, with the printer and the words supplied by a dialect.",
  "homepage": "https://github.com/pixel-perfect-software/provino#readme",
  "bugs": {
    "url": "https://github.com/pixel-perfect-software/provino/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-perfect-software/provino.git",
    "directory": "packages/snapshot"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "provino-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "provino-source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./printer": {
      "provino-source": "./src/printer/index.ts",
      "types": "./dist/printer/index.d.ts",
      "import": "./dist/printer/index.js"
    },
    "./printer-impl": {
      "provino-source": "./src/printer/impl.ts",
      "types": "./dist/printer/impl.d.ts",
      "import": "./dist/printer/impl.js"
    },
    "./inline": {
      "provino-source": "./src/inline/index.ts",
      "types": "./dist/inline/index.d.ts",
      "import": "./dist/inline/index.js"
    },
    "./runtime": {
      "provino-source": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "build": "tsdown --config ../../tooling/packaging/tsdown.config.ts",
    "test": "node ../../node_modules/provino-runner/dist/cli.js run"
  },
  "dependencies": {
    "@provino/types": "workspace:*",
    "oxc-parser": "catalog:"
  },
  "devDependencies": {
    "@provino/policy": "workspace:*",
    "natural-compare": "catalog:",
    "pretty-format": "catalog:"
  }
}
