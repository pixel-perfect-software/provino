{
  "name": "@provino/config",
  "version": "0.0.0",
  "description": "Provino's config: loading a config file, selecting the dialect, and resolving a project's policy, globs, environment and isolation into the config its workers get.",
  "homepage": "https://github.com/pixel-perfect-software/provino#readme",
  "bugs": {
    "url": "https://github.com/pixel-perfect-software/provino/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-perfect-software/provino.git",
    "directory": "packages/config"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "provino-source": "./src/index.ts",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "test": "node --test --conditions=provino-source \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@provino/policy": "workspace:*",
    "@provino/types": "workspace:*"
  }
}
