{
  "name": "@provino/dialect-vitest",
  "version": "0.1.0-rc.6",
  "description": "Provino's Vitest 5.0 dialect: Vitest's policy values, hoisting rules and title formatting. Not wired into a run yet: `provino vitest` is not available.",
  "homepage": "https://github.com/pixel-perfect-software/provino#readme",
  "bugs": {
    "url": "https://github.com/pixel-perfect-software/provino/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-perfect-software/provino.git",
    "directory": "packages/dialect-vitest"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "provino-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "provino-source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./runtime": {
      "provino-source": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./vite-bridge": {
      "provino-source": "./src/vite-bridge/index.ts",
      "types": "./dist/vite-bridge/index.d.ts",
      "import": "./dist/vite-bridge/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "build": "tsdown --config ../../tooling/packaging/tsdown.config.ts",
    "test": "node --test --conditions=provino-source \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@provino/config": "workspace:*",
    "@provino/core": "workspace:*",
    "@provino/env-jsdom": "workspace:*",
    "@provino/env-node": "workspace:*",
    "@provino/env-shared": "workspace:*",
    "@provino/expect": "workspace:*",
    "@provino/mock": "workspace:*",
    "@provino/policy": "workspace:*",
    "@provino/resolver": "workspace:*",
    "@provino/timers": "workspace:*",
    "@provino/types": "workspace:*",
    "chai": "catalog:",
    "oxc-parser": "catalog:",
    "oxc-transform": "catalog:",
    "picomatch": "catalog:",
    "tinyglobby": "catalog:"
  },
  "devDependencies": {
    "@edge-runtime/vm": "catalog:",
    "@types/picomatch": "catalog:",
    "happy-dom": "catalog:",
    "jsdom": "catalog:",
    "vitest": "catalog:"
  }
}
