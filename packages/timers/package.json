  },
  "devDependencies": {
    "@provino/env-shared": "workspace:*",
    "@provino/policy": "workspace:*",
    "@types/jsdom": "catalog:",
    "@types/sinonjs__fake-timers": "catalog:",
    "happy-dom": "catalog:",
    "jsdom": "catalog:"
  }
}
