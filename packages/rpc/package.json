{
  "name": "@provino/rpc",
  "version": "0.0.0",
  "description": "Provino's typed RPC between the coordinator and its workers: clone-safe method schemas over MessagePort and child-process IPC links.",
  "homepage": "https://github.com/pixel-perfect-software/provino#readme",
  "bugs": {
    "url": "https://github.com/pixel-perfect-software/provino/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-perfect-software/provino.git",
    "directory": "packages/rpc"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "provino-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "build": "tsdown --config ../../tooling/packaging/tsdown.config.ts",
    "test": "node --test --conditions=provino-source \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@provino/types": "workspace:*"
  }
}
