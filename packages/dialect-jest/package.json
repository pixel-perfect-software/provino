{
  "name": "@provino/dialect-jest",
  "version": "0.0.0",
  "description": "Provino's Jest 30.5 dialect: Jest's policy values and API, so a Jest project runs on Provino unchanged.",
  "homepage": "https://github.com/pixel-perfect-software/provino#readme",
  "bugs": {
    "url": "https://github.com/pixel-perfect-software/provino/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-perfect-software/provino.git",
    "directory": "packages/dialect-jest"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "provino-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "provino-source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./runtime": {
      "provino-source": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "build": "tsdown --config ../../tooling/packaging/tsdown.config.ts",
    "test": "node --test --conditions=provino-source \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@jest/expect-utils": "catalog:",
    "@jest/get-type": "catalog:",
    "@provino/config": "workspace:*",
    "@provino/core": "workspace:*",
    "@provino/env-shared": "workspace:*",
    "@provino/expect": "workspace:*",
    "@provino/mock": "workspace:*",
    "@provino/policy": "workspace:*",
    "@provino/resolver": "workspace:*",
    "@provino/timers": "workspace:*",
    "@provino/types": "workspace:*",
    "jest-matcher-utils": "catalog:",
    "jest-message-util": "catalog:",
    "jest-util": "catalog:",
    "pretty-format": "catalog:"
  },
  "devDependencies": {
    "@edge-runtime/jest-environment": "catalog:",
    "expect": "catalog:",
    "jest-cli": "catalog:",
    "jest-config": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "jest-environment-jsdom-29": "catalog:",
    "jest-environment-node": "catalog:",
    "jest-fixed-jsdom": "catalog:",
    "jest-mock": "catalog:"
  }
}
