{
  "name": "@provino/api",
  "version": "0.0.0",
  "private": true,
  "description": "Provino's native test API: the served `provino` module and its globals, for a project with no dialect (D185, D186). Inlined into `provino`.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "provino-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "build": "tsdown --config ../../tooling/packaging/tsdown.config.ts",
    "test": "node ../../node_modules/provino-runner/dist/cli.js run"
  },
  "dependencies": {
    "@provino/core": "workspace:*",
    "@provino/expect": "workspace:*",
    "@provino/lazy": "workspace:*",
    "@provino/mock": "workspace:*",
    "@provino/timers": "workspace:*",
    "@provino/types": "workspace:*"
  },
  "devDependencies": {
    "@provino/policy": "workspace:*",
    "expect-type": "catalog:"
  }
}
