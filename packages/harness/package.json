{
  "name": "@provino/harness",
  "version": "0.0.0",
  "private": true,
  "description": "Provino's differential harness: result converters for Jest and Vitest, normalization, parity diffs, the golden-fixture recorder and site data types.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "provino-source": "./src/index.ts",
      "types": "./dist/index.d.ts"
    },
    "./site": {
      "provino-source": "./src/site.ts",
      "types": "./dist/site.d.ts"
    },
    "./corpus": {
      "provino-source": "./src/corpus/index.ts",
      "types": "./dist/corpus/index.d.ts"
    },
    "./reporters/jest": {
      "provino-source": "./src/reporters/jest.ts",
      "types": "./dist/reporters/jest.d.ts"
    },
    "./reporters/vitest": {
      "provino-source": "./src/reporters/vitest.ts",
      "types": "./dist/reporters/vitest.d.ts"
    }
  },
  "bin": {
    "provino-harness": "./src/cli.ts"
  },
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "test": "node --test --conditions=provino-source \"src/**/*.test.ts\"",
    "record": "node --conditions=provino-source src/cli.ts record"
  },
  "dependencies": {
    "@provino/types": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-modules-commonjs": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@jest/globals": "catalog:",
    "@jest/test-result": "catalog:",
    "@provino/config": "workspace:*",
    "@provino/core": "workspace:*",
    "@provino/dialect-jest": "workspace:*",
    "@provino/dialect-vitest": "workspace:*",
    "@provino/env-node": "workspace:*",
    "@provino/expect": "workspace:*",
    "@provino/loader": "workspace:*",
    "@provino/mock": "workspace:*",
    "@provino/orchestrator": "workspace:*",
    "@provino/policy": "workspace:*",
    "@provino/reporters": "workspace:*",
    "@provino/resolver": "workspace:*",
    "@provino/timers": "workspace:*",
    "@provino/transform": "workspace:*",
    "@vitest/mocker": "catalog:",
    "babel-jest": "catalog:",
    "babel-plugin-jest-hoist": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "jsdom": "catalog:",
    "jest-environment-node": "catalog:",
    "jest-html-reporters": "catalog:",
    "jest-junit": "catalog:",
    "jest-silent-reporter": "catalog:",
    "jest-sonar-reporter": "catalog:",
    "jest-config": "catalog:",
    "jest-serializer-vue": "catalog:",
    "oxc-parser": "catalog:",
    "prettier": "catalog:",
    "provino": "workspace:*",
    "vitest": "catalog:"
  }
}
