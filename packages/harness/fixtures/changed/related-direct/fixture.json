{
  "description": "--findRelatedTests selects the test that requires the file directly. Jest only.",
  "runners": ["jest"],
  "run": {
    "argv": {
      "jest": ["--listTests", "--findRelatedTests", "src/foo.ts"]
    },
    "capture": ["exitCode", "file:.harness-out/jest.json"],
    "sortStdout": "json"
  }
}
