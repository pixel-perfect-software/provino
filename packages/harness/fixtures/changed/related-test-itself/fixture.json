{
  "description": "--findRelatedTests with a test file selects that test file itself. Jest only.",
  "runners": ["jest"],
  "run": {
    "argv": {
      "jest": ["--listTests", "--findRelatedTests", "foo.test.ts"]
    },
    "capture": ["exitCode", "file:.harness-out/jest.json"],
    "sortStdout": "json"
  }
}
