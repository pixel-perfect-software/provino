{
  "description": "Two inline snapshots on one line (B23d B1, T7.11): each call is found by its own column, so both are written. Jest 30.5.2, `prettierPath: null`.",
  "runners": ["jest"],
  "env": {
    "CI": ""
  },
  "config": {
    "jest": {
      "prettierPath": null
    }
  },
  "run": {
    "argv": {
      "jest": ["--ci=false"]
    },
    "capture": ["exitCode", "file:inline-two-on-one-line.test.ts", "stderr"],
    "keepLines": "^(PASS|FAIL) |^(Test Suites|Tests|Snapshots):|^ +● |^ › |^ +↳ |^ +• |^    [A-Z]"
  }
}
