{
  "description": "The same `import`s from a test file Jest runs as an ES module (`extensionsToTreatAsEsm: ['.ts']`, Node with `--experimental-vm-modules`, no CommonJS transform), in the node environment: jest-runtime resolves an ES module's edges with its ESM conditions (`import`, `module-sync`, `default` and the environment's `node`, `node-addons`), so both get `node-import`. The package `dual` has `exports` with `worker`, `browser` and `node` branches (each with an `import` and a `require` entry), then `import`, `require` and `default`; each entry's value names it, and each test's title is the entry it got.",
  "runners": ["jest"],
  "nodeFlags": ["--experimental-vm-modules"],
  "config": {
    "jest": {
      "testEnvironment": "node",
      "extensionsToTreatAsEsm": [".ts"]
    }
  },
  "packages": {
    "dual": {
      "package.json": "{\"name\":\"dual\",\"version\":\"1.0.0\",\"exports\":{\".\":{\"worker\":{\"import\":\"./worker-import.mjs\",\"require\":\"./worker-require.cjs\"},\"browser\":{\"import\":\"./browser-import.mjs\",\"require\":\"./browser-require.cjs\"},\"node\":{\"import\":\"./node-import.mjs\",\"require\":\"./node-require.cjs\"},\"import\":\"./esm.mjs\",\"require\":\"./cjs.cjs\",\"default\":\"./default.cjs\"}}}\n",
      "esm.mjs": "export default 'import'\n",
      "cjs.cjs": "module.exports = 'require'\n",
      "default.cjs": "module.exports = 'default'\n",
      "worker-import.mjs": "export default 'worker-import'\n",
      "worker-require.cjs": "module.exports = 'worker-require'\n",
      "browser-import.mjs": "export default 'browser-import'\n",
      "browser-require.cjs": "module.exports = 'browser-require'\n",
      "node-import.mjs": "export default 'node-import'\n",
      "node-require.cjs": "module.exports = 'node-require'\n"
    }
  },
  "run": {
    "argv": {
      "jest": ["-w", "1"]
    },
    "capture": ["exitCode", "stderr", "json:.harness-out/jest.json"],
    "keepLines": "^(PASS|FAIL) |^(Test Suites|Tests|Snapshots):|^ +● |^    [A-Z]",
    "timeKeys": ["startTime", "endTime", "duration", "startAt", "start", "end", "runtime"]
  }
}
