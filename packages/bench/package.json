{
  "name": "@provino/bench",
  "version": "0.0.0",
  "private": true,
  "description": "Provino's benchmark protocol (Track 12 R5): interleaved warm and cold runs, tree RSS, bootstrap CIs, BenchRecord output, and the synthetic suite generators.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "provino-source": "./src/index.ts",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "provino-bench": "./src/cli.ts"
  },
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "test": "node --test --conditions=provino-source \"src/**/*.test.ts\"",
    "bench": "node --conditions=provino-source src/cli.ts"
  },
  "dependencies": {
    "@provino/core": "workspace:*",
    "@provino/dialect-jest": "workspace:*",
    "@provino/env-node": "workspace:*",
    "@provino/expect": "workspace:*",
    "@provino/harness": "workspace:*",
    "@provino/loader": "workspace:*",
    "@provino/mock": "workspace:*",
    "@provino/orchestrator": "workspace:*",
    "@provino/policy": "workspace:*",
    "@provino/resolver": "workspace:*",
    "@provino/timers": "workspace:*",
    "@provino/transform": "workspace:*",
    "@provino/types": "workspace:*",
    "provino": "workspace:*"
  },
  "devDependencies": {
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@vitest/spy": "catalog:",
    "date-fns": "catalog:",
    "es-module-lexer": "catalog:",
    "expect": "catalog:",
    "jest": "catalog:",
    "jest-config": "catalog:",
    "jest-mock": "catalog:",
    "lodash": "catalog:",
    "magic-string": "catalog:",
    "pretty-format": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
