{
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  // `provino/globals/native` declares `test` and `it` as the native API types them, which
  // `globals.ts` types as the Jest dialect does: one program can't hold both, so it is a project of its own.
  "exclude": ["src/globals-native", "src/**/*.test.ts"],
  "references": [
    { "path": "../types" },
    { "path": "./src/globals-native" },
    { "path": "../api" },
    { "path": "../config" },
    { "path": "../reporters" },
    { "path": "../orchestrator" },
    { "path": "../transform" },
    { "path": "../coverage" },
    { "path": "../dialect-jest" },
    { "path": "../dialect-vitest" },
    { "path": "../env-jsdom" },
    { "path": "../env-node" },
    { "path": "../lazy" },
    { "path": "../core" },
    { "path": "../env-shared" },
    { "path": "../mock" },
    { "path": "../policy" },
    { "path": "../timers" },
    { "path": "../resolver" }
  ]
}
