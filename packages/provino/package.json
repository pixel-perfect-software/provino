{
  "name": "provino",
  "version": "0.1.0-rc.12",
  "description": "A test runner for JavaScript and TypeScript that runs Jest projects with Jest's config, command line, matchers and snapshots. Pre-alpha: Vitest support is not built yet.",
  "keywords": [
    "test",
    "testing",
    "test-runner",
    "jest",
    "typescript",
    "snapshot",
    "mock"
  ],
  "homepage": "https://github.com/pixel-perfect-software/provino#readme",
  "bugs": {
    "url": "https://github.com/pixel-perfect-software/provino/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-perfect-software/provino.git",
    "directory": "packages/provino"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "provino-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./globals": {
      "provino-source": "./src/globals.ts",
      "types": "./dist/globals.d.ts",
      "import": "./dist/globals.js",
      "default": "./dist/globals.js"
    },
    "./globals/native": {
      "provino-source": "./src/globals-native/index.ts",
      "types": "./dist/globals-native.d.ts",
      "import": "./dist/globals-native.js",
      "default": "./dist/globals-native.js"
    },
    "./config": {
      "provino-source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./node": {
      "provino-source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./reporters": {
      "provino-source": "./src/reporters.ts",
      "types": "./dist/reporters.d.ts",
      "import": "./dist/reporters.js",
      "default": "./dist/reporters.js"
    },
    "./environment": {
      "provino-source": "./src/environment.ts",
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js",
      "default": "./dist/environment.js"
    },
    "./jest": {
      "provino-source": "./src/jest.ts",
      "types": "./dist/jest.d.ts",
      "import": "./dist/jest.js",
      "default": "./dist/jest.js"
    },
    "./vitest": {
      "provino-source": "./src/vitest.ts",
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js",
      "default": "./dist/vitest.js"
    },
    "./internal/jest-runtime": {
      "provino-source": "./src/internal/engine/jest-runtime.ts",
      "types": "./dist/internal/jest-runtime.d.ts",
      "import": "./dist/internal/jest-runtime.js",
      "default": "./dist/internal/jest-runtime.js"
    },
    "./internal/vitest-runtime": {
      "provino-source": "./src/internal/engine/vitest-runtime.ts",
      "types": "./dist/internal/vitest-runtime.d.ts",
      "import": "./dist/internal/vitest-runtime.js",
      "default": "./dist/internal/vitest-runtime.js"
    },
    "./internal/config": {
      "provino-source": "./src/internal/engine/config.ts",
      "types": "./dist/internal/config.d.ts",
      "import": "./dist/internal/config.js",
      "default": "./dist/internal/config.js"
    },
    "./internal/resolver": {
      "provino-source": "./src/internal/engine/resolver.ts",
      "types": "./dist/internal/resolver.d.ts",
      "import": "./dist/internal/resolver.js",
      "default": "./dist/internal/resolver.js"
    },
    "./internal/env-node": {
      "provino-source": "./src/internal/engine/env-node.ts",
      "types": "./dist/internal/env-node.d.ts",
      "import": "./dist/internal/env-node.js",
      "default": "./dist/internal/env-node.js"
    },
    "./internal/vite-alias": {
      "provino-source": "./src/internal/engine/vite-alias.ts",
      "types": "./dist/internal/vite-alias.d.ts",
      "import": "./dist/internal/vite-alias.js",
      "default": "./dist/internal/vite-alias.js"
    },
    "./internal/types": {
      "provino-source": "./src/internal/engine/types.ts",
      "types": "./dist/internal/types.d.ts",
      "import": "./dist/internal/types.js",
      "default": "./dist/internal/types.js"
    },
    "./package.json": {
      "provino-source": "./package.json",
      "default": "./package.json"
    }
  },
  "bin": {
    "provino": "./src/cli.ts"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "build": "tsdown --config ../../tooling/packaging/tsdown.umbrella.config.ts",
    "test": "node ../../tooling/packaging/src/runner-shard.ts && node ../../tooling/packaging/src/node-test.ts --conditions=provino-source src/index.test.ts test/bootstrap/canary.test.ts"
  },
  "dependencies": {
    "@bcoe/v8-coverage": "catalog:",
    "@istanbuljs/schema": "catalog:",
    "@jridgewell/remapping": "catalog:",
    "@jridgewell/trace-mapping": "catalog:",
    "@sinonjs/fake-timers": "catalog:",
    "@standard-schema/spec": "catalog:",
    "es-module-lexer": "catalog:",
    "istanbul-lib-coverage": "catalog:",
    "istanbul-lib-report": "catalog:",
    "istanbul-lib-source-maps": "catalog:",
    "istanbul-reports": "catalog:",
    "magic-string": "catalog:",
    "oxc-parser": "catalog:",
    "oxc-resolver": "catalog:",
    "oxc-transform": "catalog:",
    "oxc-walker": "catalog:",
    "picomatch": "catalog:",
    "tinyglobby": "catalog:",
    "v8-to-istanbul": "catalog:"
  },
  "publishConfig": {
    "bin": {
      "provino": "./dist/cli.js"
    }
  },
  "devDependencies": {
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@provino/api": "workspace:*",
    "@provino/config": "workspace:*",
    "@provino/core": "workspace:*",
    "@provino/coverage": "workspace:*",
    "@provino/dialect-jest": "workspace:*",
    "@provino/dialect-vitest": "workspace:*",
    "@provino/env-jsdom": "workspace:*",
    "@provino/env-node": "workspace:*",
    "@provino/env-shared": "workspace:*",
    "@provino/expect": "workspace:*",
    "@provino/lazy": "workspace:*",
    "@provino/mock": "workspace:*",
    "@provino/orchestrator": "workspace:*",
    "@provino/policy": "workspace:*",
    "@provino/reporters": "workspace:*",
    "@provino/resolver": "workspace:*",
    "@provino/snapshot": "workspace:*",
    "@provino/timers": "workspace:*",
    "@provino/transform": "workspace:*",
    "@provino/types": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "babel-jest": "catalog:",
    "identity-obj-proxy": "catalog:",
    "jest-axe": "catalog:",
    "jest-canvas-mock": "catalog:",
    "jest-environment-node": "catalog:",
    "jest-extended": "catalog:",
    "jest-fetch-mock": "catalog:",
    "jest-html-reporters": "catalog:",
    "jest-image-snapshot": "catalog:",
    "jest-junit": "catalog:",
    "jest-mock-extended": "catalog:",
    "jest-silent-reporter": "catalog:",
    "jest-snapshot": "catalog:",
    "jest-sonar-reporter": "catalog:",
    "jest-styled-components": "catalog:",
    "jest-watch-typeahead": "catalog:",
    "jest-when": "catalog:",
    "msw": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "styled-components": "catalog:",
    "typescript": "catalog:",
    "typescript-5.9": "catalog:"
  },
  "peerDependencies": {
    "jsdom": ">=26 <31",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
