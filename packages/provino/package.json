{
  "name": "provino",
  "version": "0.0.0",
  "description": "A test runner for JavaScript and TypeScript that runs Jest projects with Jest's config, command line, matchers and snapshots. Pre-alpha: Vitest support is not built yet.",
  "keywords": [
    "test",
    "testing",
    "test-runner",
    "jest",
    "typescript",
    "snapshot",
    "mock"
  ],
  "homepage": "https://github.com/pixel-perfect-software/provino#readme",
  "bugs": {
    "url": "https://github.com/pixel-perfect-software/provino/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-perfect-software/provino.git",
    "directory": "packages/provino"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "provino-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./globals": {
      "provino-source": "./src/globals.ts",
      "types": "./dist/globals.d.ts",
      "import": "./dist/globals.js"
    },
    "./config": {
      "provino-source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./node": {
      "provino-source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./reporters": {
      "provino-source": "./src/reporters.ts",
      "types": "./dist/reporters.d.ts",
      "import": "./dist/reporters.js"
    },
    "./environment": {
      "provino-source": "./src/environment.ts",
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js"
    },
    "./jest": {
      "provino-source": "./src/jest.ts",
      "types": "./dist/jest.d.ts",
      "import": "./dist/jest.js"
    },
    "./package.json": {
      "provino-source": "./package.json",
      "default": "./package.json"
    }
  },
  "bin": {
    "provino": "./src/cli.ts"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "build": "tsdown --config ../../tooling/packaging/tsdown.umbrella.config.ts",
    "test": "node --test --conditions=provino-source \"src/**/*.test.ts\" \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@istanbuljs/schema": "catalog:",
    "@jest/expect-utils": "catalog:",
    "@jest/get-type": "catalog:",
    "@jridgewell/remapping": "catalog:",
    "@jridgewell/trace-mapping": "catalog:",
    "@sinonjs/fake-timers": "catalog:",
    "@standard-schema/spec": "catalog:",
    "es-module-lexer": "catalog:",
    "istanbul-lib-coverage": "catalog:",
    "jest-matcher-utils": "catalog:",
    "jest-message-util": "catalog:",
    "jest-util": "catalog:",
    "magic-string": "catalog:",
    "oxc-parser": "catalog:",
    "oxc-resolver": "catalog:",
    "oxc-transform": "catalog:",
    "oxc-walker": "catalog:",
    "picomatch": "catalog:",
    "pretty-format": "catalog:",
    "pure-rand": "catalog:",
    "tinyglobby": "catalog:"
  },
  "publishConfig": {
    "bin": {
      "provino": "./dist/cli.js"
    }
  },
  "devDependencies": {
    "@provino/config": "workspace:*",
    "@provino/coverage": "workspace:*",
    "@provino/dialect-jest": "workspace:*",
    "@provino/env-jsdom": "workspace:*",
    "@provino/env-node": "workspace:*",
    "@provino/lazy": "workspace:*",
    "@provino/orchestrator": "workspace:*",
    "@provino/reporters": "workspace:*",
    "@provino/transform": "workspace:*",
    "@provino/types": "workspace:*",
    "jest-html-reporters": "catalog:",
    "jest-junit": "catalog:",
    "jest-silent-reporter": "catalog:",
    "jest-sonar-reporter": "catalog:"
  },
  "peerDependencies": {
    "jsdom": ">=26 <31"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  }
}
