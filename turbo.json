{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test-d.ts",
        "$TURBO_ROOT$/tooling/packaging/package.json",
        "$TURBO_ROOT$/tooling/packaging/tsdown.config.ts",
        "$TURBO_ROOT$/tooling/packaging/tsdown.umbrella.config.ts",
        "$TURBO_ROOT$/tooling/packaging/src/**",
        "!$TURBO_ROOT$/tooling/packaging/src/**/*.test.ts"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["transit"],
      "env": ["PROVINO_NODE"],
      "passThroughEnv": ["NODE_OPTIONS", "TMPDIR"],
      "outputs": []
    },
    "bench": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "record": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
