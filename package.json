{
  "name": "provino-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A test runner for JavaScript and TypeScript that runs Jest projects with Jest's config, command line, matchers and snapshots. Pre-alpha: Vitest support and lazy variables are not built yet.",
  "homepage": "https://github.com/pixel-perfect-software/provino#readme",
  "bugs": {
    "url": "https://github.com/pixel-perfect-software/provino/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-perfect-software/provino.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "turbo run build",
    "test": "PROVINO_NODE=$(node -p process.version) turbo run test",
    "test:types": "tsc -b tsconfig.type-tests.json",
    "test:types:ts5.9": "node node_modules/typescript-5.9/bin/tsc -b tsconfig.type-tests.json",
    "lint": "biome check --formatter-enabled=false",
    "format": "biome format --write",
    "format:check": "biome format",
    "boundaries": "node tooling/boundaries/src/cli.ts check",
    "boundaries:write": "node tooling/boundaries/src/cli.ts write",
    "provino": "node --conditions=provino-source packages/provino/src/cli.ts",
    "provino-bench": "node --conditions=provino-source packages/bench/src/cli.ts",
    "provino-harness": "node --conditions=provino-source packages/harness/src/cli.ts",
    "record:runtime": "node --conditions=provino-source packages/harness/src/cli.ts record packages/harness/fixtures/runtime",
    "record:expect": "node --conditions=provino-source packages/harness/src/cli.ts record packages/harness/fixtures/expect packages/harness/fixtures/snapshot",
    "record:mocking": "node --conditions=provino-source packages/harness/src/cli.ts record packages/harness/fixtures/mocking",
    "bench:resolve": "node --conditions=provino-source packages/resolver/bench/resolve-corpus.ts",
    "bench:excalidraw": "node --conditions=provino-source packages/transform/bench/excalidraw.ts",
    "bench:transform-cache": "node --conditions=provino-source packages/transform/bench/transform-cache.ts",
    "bench:v8-cache": "node --conditions=provino-source packages/transform/bench/v8-cache.ts",
    "bench:runner-fuzz": "node --conditions=provino-source packages/transform/bench/runner-fuzz.ts",
    "bench:runner-diff": "node --conditions=provino-source packages/transform/bench/runner-diff.ts",
    "bench:loader": "node --conditions=provino-source packages/bench/src/loader/cli.ts",
    "bench:worker": "node --conditions=provino-source packages/bench/src/worker/cli.ts",
    "bench:expect": "node --conditions=provino-source packages/bench/src/expect/cli.ts",
    "bench:expect-import": "pnpm --filter provino build && node --conditions=provino-source packages/bench/src/expect-import/cli.ts",
    "bench:env": "node --expose-gc --conditions=provino-source packages/bench/src/env/cli.ts",
    "bench:mock": "node --conditions=provino-source packages/bench/src/mock/cli.ts",
    "bench:core": "node --conditions=provino-source packages/bench/src/core/cli.ts",
    "bench:hoist": "node --conditions=provino-source packages/bench/src/hoist/cli.ts",
    "bench:jest-config": "node --conditions=provino-source packages/bench/src/jest-config/cli.ts",
    "hoist:extract": "node --conditions=provino-source packages/harness/src/hoist-corpus/extract-upstream.ts",
    "deps:check": "autd check",
    "deps:update": "autd update",
    "hygiene": "pnpm build && node tooling/packaging/src/cli.ts hygiene",
    "hygiene:update-api": "pnpm build && node tooling/packaging/src/cli.ts hygiene --update-api",
    "pack:all": "pnpm build && node tooling/packaging/src/cli.ts pack",
    "smoke:install": "pnpm build && node tooling/packaging/src/cli.ts smoke",
    "changeset": "changeset",
    "knip": "knip"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@pixel-perfect-software/always-up-to-date": "catalog:",
    "@types/node": "catalog:",
    "@typescript/typescript6": "catalog:",
    "dependency-cruiser": "catalog:",
    "expect-type": "catalog:",
    "knip": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-5.9": "catalog:"
  }
}
