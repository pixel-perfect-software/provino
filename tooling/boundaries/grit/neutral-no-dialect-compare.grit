// Neutral packages never branch on a runner name (CLAUDE.md non-negotiable 1): no `=== 'jest'`,
// `!= "vitest"`, or `case 'jest':`. Which packages are neutral comes from packages.json, through
// the generated biome-plugins.json.
language js

or {
  `$a === $b`,
  `$a == $b`,
  `$a !== $b`,
  `$a != $b`,
  JsCaseClause(test=$a)
} as $cmp where {
  or { $a <: r"['\"](?:jest|vitest)['\"]", $b <: r"['\"](?:jest|vitest)['\"]" },
  register_diagnostic(span=$cmp, message="neutral-no-dialect-compare: neutral packages never compare against 'jest' or 'vitest'; read a typed policy key the dialect supplies instead (CLAUDE.md non-negotiable 1).")
}
