    "provino-site": {
      "dir": null,
      "layer": "dev",
      "runsIn": "dev",
      "deps": [],
      "slices": [],
      "note": "The compatibility and benchmark site (DECISIONS D8); T12.18 places it."
    },
    "provino-boundaries": {
      "dir": "tooling/boundaries",
      "layer": "tooling",
      "runsIn": "dev",
      "deps": ["@provino/types", "@provino/policy"],
      "slices": "all"
    }
  }
