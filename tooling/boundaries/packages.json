    "@provino/jest-globals": {
      "dir": "packages/jest-globals",
      "layer": 6,
      "runsIn": "worker",
      "deps": ["@provino/types", "@provino/dialect-jest/runtime"],
      "slices": [],
      "phase": 2,
      "note": "npm alias package for `@jest/globals` (T11)."
    },
    "@provino/harness": {
      "dir": "packages/harness",
      "layer": "dev",
      "runsIn": "dev",
      "deps": ["@provino/*", "provino"],
      "slices": "all",
      "note": "Runs Provino only through provino/node (DECISIONS S4)."
    },
    "@provino/bench": {
