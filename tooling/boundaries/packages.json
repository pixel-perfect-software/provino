    },
    "@provino/dialect-vitest/runtime": {
      "dir": "packages/dialect-vitest/src/runtime",
      "layer": 5,
      "runsIn": "worker",
      "deps": [
        "@provino/types",
        "@provino/policy",
        "@provino/core",
        "@provino/lazy",
        "@provino/expect",
        "@provino/mock",
        "@provino/timers",
        "@provino/dialect-vitest"
      ],
      "slices": "all"
    },
    "@provino/dialect-node-test": {
      "dir": "packages/dialect-node-test",
      "layer": 5,
      "runsIn": "both",
      "deps": ["@provino/types", "@provino/policy"],
      "slices": "all",
      "phase": 4,
      "note": "Private third-dialect conformance check (T1.11)."
    },
    "@provino/dialect-node-test/runtime": {
      "dir": "packages/dialect-node-test/src/runtime",
      "layer": 5,
      "runsIn": "worker",
      "deps": [
        "@provino/types",
        "@provino/policy",
        "@provino/core",
        "@provino/mock",
        "@provino/dialect-node-test"
      ],
      "slices": "all",
      "phase": 4
    },
    "provino": {
      "dir": "packages/provino",
      "layer": 6,
      "runsIn": "both",
      "compositionRoot": true,
      "deps": ["@provino/*"],
      "slices": [],
      "note": "The umbrella and CLI. Its subpaths split by process; the build pre-bundles the worker hot path."
    },
    "@provino/vitest-compat": {
      "dir": "packages/vitest-compat",
      "layer": 6,
      "runsIn": "both",
